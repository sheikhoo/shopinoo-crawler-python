INGEST_API_URL=http://localhost:4000/api/internal/ingest/businesses
CRAWLER_SERVICE_TOKEN=change-me-crawler-token
SEED_CSV=./seeds/shops.csv
DIRECTORIES_CSV=./seeds/directories.csv
# صف پایدار محلی (پیش‌فرض) — بعد از توقف از همین‌جا ادامه می‌دهد
CRAWLER_DB_PATH=./data/crawler.db
# REDIS_URL=redis://localhost:6379
# CRAWLER_REDISCOVER=false
REQUESTS_PER_MINUTE=20
PER_HOST_DELAY_MS=2500
MAX_PAGES_PER_DOMAIN=8
FETCH_TIMEOUT_MS=12000
USER_AGENT=ShopinoBot/1.0 (+https://shopinoo-plus.ir/bot)
DISCOVER_ENABLED=true
MAX_DISCOVER_PER_PAGE=100
MAX_EXPAND_PER_DOMAIN=40
MAX_DOMAINS_PER_RUN=200
# رندر JS برای فوتر/شبکه‌های اجتماعی (مثل خانومی)
USE_PLAYWRIGHT=true
PLAYWRIGHT_WAIT_MS=8000
# در ایران: msedge یا chrome (مرورگر سیستم) — نه دانلود chromium
PLAYWRIGHT_CHANNEL=msedge
